          "commit": "31e8bb083b307e1cc96af4874a94707727bd1e79"
        }
      ]
    },
    {
      "name": "screen-orientation-manager",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/archisman-panigrahi/surface-RT-screen-rotator.git",
          "branch": "screen-orientation-manager"
        }
      ]
    }
  ]
}
